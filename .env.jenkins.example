# Jenkins Environment Configuration
# Copy this file to .env and update with your values

# Jenkins Controller Configuration
JENKINS_URL=http://localhost:8080

# Jenkins Agent Secrets (Get these from Jenkins UI after setup)
# Manage Jenkins > Manage Nodes and Clouds > Select agent > View secret
JENKINS_BUILD_AGENT_SECRET=
JENKINS_TEST_AGENT_SECRET=
JENKINS_E2E_AGENT_SECRET=
JENKINS_DEPLOY_AGENT_SECRET=

# Docker Registry
DOCKER_REGISTRY=localhost:5001
DOCKER_REGISTRY_USERNAME=admin
DOCKER_REGISTRY_PASSWORD=admin

# Image Configuration
IMAGE_PREFIX=club-management

# AWS Configuration (if deploying to AWS)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Deployment Hosts
STAGING_HOST=staging.example.com
PROD_HOST=prod.example.com

# Notification (optional)
SLACK_WEBHOOK_URL=
EMAIL_RECIPIENTS=team@example.com

# Deployment Method
# Options: docker-compose, k8s, ecs
DEPLOYMENT_METHOD=docker-compose
