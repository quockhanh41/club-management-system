# ============================================
# E2E Test Runner Dockerfile
# Multi-stage build for better caching and faster rebuilds
# ============================================

# ============================================
# Stage 1: Dependencies
# ============================================
FROM mcr.microsoft.com/playwright:v1.57.0-jammy AS deps

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies for tests)
# This layer will be cached unless package files change
RUN npm ci

# ============================================
# Stage 2: Test runner
# ============================================
FROM mcr.microsoft.com/playwright:v1.57.0-jammy AS runner

WORKDIR /app

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy package files
COPY package*.json ./

# Copy all source code and tests
COPY . .

# Set environment
ENV CI=true
ENV PYTHONUNBUFFERED=1
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Default command runs E2E tests with real-time output
# line reporter shows progress, list shows final summary
CMD ["npx", "playwright", "test", "--reporter=list,html,junit,json"]
