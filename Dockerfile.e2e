# E2E Test Runner Dockerfile
# Builds an image with code and Playwright for running E2E tests in CI

FROM mcr.microsoft.com/playwright:v1.57.0-jammy

WORKDIR /app

# Copy package files  
COPY package*.json ./

# Install all dependencies (including dev dependencies for tests)
RUN npm ci

# Copy all source code and tests
COPY . .

# Set environment
ENV CI=true
ENV PYTHONUNBUFFERED=1
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Default command runs E2E tests with real-time output
# line reporter shows progress, list shows final summary
CMD ["npx", "playwright", "test", "--reporter=list,html,junit"]
