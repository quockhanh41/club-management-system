# Production Environment Variables for Club Service
# =================================================

NODE_ENV=production
PORT=3002

# Database Connection (Required)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.net/club_db

# Security (Required)
# Must match the secret configured in API Gateway (Kong)
API_GATEWAY_SECRET=c44d002c75b696ba2200d49c6fadb8f3

# Message Queue (Optional but recommended)
RABBITMQ_URL=amqps://user:pass@host/vhost

# Service Dependencies
AUTH_SERVICE_URL=http://auth-service:3001
EVENT_SERVICE_URL=http://event-service:3003
