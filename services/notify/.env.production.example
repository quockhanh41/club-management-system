# Production Environment Variables for Notification Service
# =========================================================

NODE_ENV=production
PORT=3005

# RabbitMQ (Required)
RABBITMQ_URL=amqps://user:pass@host/vhost
RABBITMQ_EXCHANGE=club_events

# Email Service (SMTP) (Required)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="Club Management <no-reply@club.com>"

# Security
API_GATEWAY_SECRET=c44d002c75b696ba2200d49c6fadb8f3

# Frontend Integration
FRONTEND_BASE_URL=https://club-management.com

# Resilience
MAX_RETRY_ATTEMPTS=5
